{
  "name": "bridge-orchestrator",
  "version": "0.1.0",
  "description": "Bridge: Codex 规划审查、Pi 隔离施工的本地长任务编排器",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/copy-sql-migrations.mjs",
    "test": "vitest run --pool=threads",
    "check": "npm run build && npm test",
    "brainctl": "node dist/cli/brainctl.js"
  },
  "bin": {
    "brainctl": "dist/cli/brainctl.js"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.5"
  }
}
