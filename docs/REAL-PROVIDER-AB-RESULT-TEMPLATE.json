{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codex-brain-pi-orchestrator.local/schemas/real-provider-ab-result.json",
  "title": "Real Provider A/B Result Report",
  "description": "Schema for disposable Pi/Codex Provider A/B test result reports. All runs across three modes must share identical taskFingerprint, qualityGateFingerprint, and acceptanceFingerprint.",
  "type": "object",
  "required": ["reportMeta", "runs"],
  "additionalProperties": false,
  "properties": {
    "reportMeta": {
      "type": "object",
      "description": "Report-level metadata.",
      "required": ["reportId", "generatedAt", "dataClassification"],
      "additionalProperties": false,
      "properties": {
        "reportId": {
          "type": "string",
          "description": "Sanitized/random report identifier. Must not contain user names, real project paths, or credentials.",
          "minLength": 1,
          "maxLength": 128
        },
        "generatedAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of report generation.",
          "format": "date-time"
        },
        "dataClassification": {
          "type": "string",
          "description": "Overall data classification for this report. Must be 'synthetic' if any usage/cost field has status 'synthetic'. Must be 'confirmed' for a real A/B report.",
          "enum": ["confirmed", "synthetic"]
        }
      }
    },
    "runs": {
      "type": "array",
      "description": "Array of individual A/B runs. Minimum 9 entries (3 modes × 3 repeats).",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": [
          "runId",
          "mode",
          "repeatNumber",
          "timestamp",
          "modelInfo",
          "taskFingerprint",
          "qualityGateFingerprint",
          "acceptanceFingerprint",
          "correctness",
          "usage",
          "cost",
          "timing",
          "evidencePaths"
        ],
        "additionalProperties": false,
        "properties": {
          "runId": {
            "type": "string",
            "description": "Sanitized/random run identifier. Must not contain user names, real project paths, or credentials.",
            "minLength": 1,
            "maxLength": 128
          },
          "mode": {
            "type": "string",
            "description": "A/B test mode for this run.",
            "enum": ["sequential-baseline", "default-orchestrated", "token-efficient"]
          },
          "repeatNumber": {
            "type": "integer",
            "description": "1-based repeat index within this mode.",
            "minimum": 1
          },
          "timestamp": {
            "type": "string",
            "description": "ISO 8601 timestamp of run start.",
            "format": "date-time"
          },
          "modelInfo": {
            "type": "object",
            "description": "Model and provider version information (immutable across all runs).",
            "required": ["model", "providerVersion", "environmentType"],
            "additionalProperties": false,
            "properties": {
              "model": {
                "type": "string",
                "description": "Model identifier (e.g. 'qwen/qwen3.7-plus:high').",
                "minLength": 1
              },
              "providerVersion": {
                "type": "string",
                "description": "Locked provider version string.",
                "minLength": 1
              },
              "environmentType": {
                "type": "string",
                "description": "Must be 'disposable' for real A/B.",
                "enum": ["disposable"]
              }
            }
          },
          "taskFingerprint": {
            "type": "string",
            "description": "SHA-256 hex digest of the stable-sorted task set. Must be identical across all modes and repeats.",
            "pattern": "^[a-f0-9]{64}$"
          },
          "qualityGateFingerprint": {
            "type": "string",
            "description": "SHA-256 hex digest of the quality gate configuration. Must be identical across all modes and repeats.",
            "pattern": "^[a-f0-9]{64}$"
          },
          "acceptanceFingerprint": {
            "type": "string",
            "description": "SHA-256 hex digest of the acceptance criteria. Must be identical across all modes and repeats.",
            "pattern": "^[a-f0-9]{64}$"
          },
          "correctness": {
            "type": "object",
            "description": "Correctness gate results for this run.",
            "required": [
              "runStatus",
              "stageStatus",
              "allTasksMerged",
              "targetBranchContentCorrect",
              "hasConflict",
              "hasPaused",
              "hasWaitingDecision",
              "hasMergeBlocked",
              "hasLeftoverWorktree"
            ],
            "additionalProperties": false,
            "properties": {
              "runStatus": {
                "type": "string",
                "description": "Final run status.",
                "enum": ["completed", "failed", "cancelled"]
              },
              "stageStatus": {
                "type": "string",
                "description": "Final stage status (all stages).",
                "enum": ["completed", "failed", "partial"]
              },
              "allTasksMerged": {
                "type": "boolean",
                "description": "Whether all tasks were successfully merged."
              },
              "targetBranchContentCorrect": {
                "type": "boolean",
                "description": "Whether target branch content matches expected output item by item."
              },
              "hasConflict": {
                "type": "boolean",
                "description": "Whether any conflict was detected."
              },
              "hasPaused": {
                "type": "boolean",
                "description": "Whether any task was left in paused state."
              },
              "hasWaitingDecision": {
                "type": "boolean",
                "description": "Whether any task was left waiting for a decision."
              },
              "hasMergeBlocked": {
                "type": "boolean",
                "description": "Whether any merge was blocked."
              },
              "hasLeftoverWorktree": {
                "type": "boolean",
                "description": "Whether any worktree was left uncleaned."
              }
            }
          },
          "usage": {
            "type": "object",
            "description": "Token usage metrics for this run.",
            "required": ["codex", "pi", "totalTokens", "totalTokensStatus"],
            "additionalProperties": false,
            "properties": {
              "codex": {
                "type": "object",
                "required": ["inputTokens", "outputTokens", "cacheTokens", "callCount", "status"],
                "additionalProperties": false,
                "properties": {
                  "inputTokens": { "type": "integer", "minimum": 0 },
                  "outputTokens": { "type": "integer", "minimum": 0 },
                  "cacheTokens": { "type": "integer", "minimum": 0 },
                  "callCount": { "type": "integer", "minimum": 0 },
                  "status": {
                    "type": "string",
                    "enum": ["confirmed", "estimated", "unavailable", "synthetic"]
                  }
                }
              },
              "pi": {
                "type": "object",
                "required": ["inputTokens", "outputTokens", "cacheTokens", "status"],
                "additionalProperties": false,
                "properties": {
                  "inputTokens": { "type": "integer", "minimum": 0 },
                  "outputTokens": { "type": "integer", "minimum": 0 },
                  "cacheTokens": { "type": "integer", "minimum": 0 },
                  "status": {
                    "type": "string",
                    "enum": ["confirmed", "estimated", "unavailable", "synthetic"]
                  }
                }
              },
              "totalTokens": {
                "type": "integer",
                "description": "Sum of all token usage across providers.",
                "minimum": 0
              },
              "totalTokensStatus": {
                "type": "string",
                "description": "Status of total token figure. Must be consistent with codex.status and pi.status.",
                "enum": ["confirmed", "estimated", "unavailable", "synthetic"]
              }
            }
          },
          "cost": {
            "type": "object",
            "description": "Cost metrics for this run.",
            "required": ["weightedCost", "status"],
            "additionalProperties": false,
            "properties": {
              "weightedCost": {
                "type": "number",
                "description": "Weighted cost in arbitrary consistent units.",
                "minimum": 0
              },
              "status": {
                "type": "string",
                "enum": ["confirmed", "estimated", "unavailable", "synthetic"]
              }
            }
          },
          "timing": {
            "type": "object",
            "description": "Timing and reliability metrics for this run.",
            "required": ["wallTimeMs", "retryCount", "failureCount", "recoveryTimeMs"],
            "additionalProperties": false,
            "properties": {
              "wallTimeMs": {
                "type": "integer",
                "description": "Total wall-clock time in milliseconds.",
                "minimum": 0
              },
              "retryCount": {
                "type": "integer",
                "description": "Number of retries within this run.",
                "minimum": 0
              },
              "failureCount": {
                "type": "integer",
                "description": "Number of task/stage failures in this run.",
                "minimum": 0
              },
              "recoveryTimeMs": {
                "type": "integer",
                "description": "Time spent in recovery/retry in milliseconds.",
                "minimum": 0
              }
            }
          },
          "evidencePaths": {
            "type": "array",
            "description": "Relative POSIX paths to evidence files. Must not contain absolute paths, '..', backslashes, user names, or project-specific real paths.",
            "items": {
              "type": "string",
              "pattern": "^(evidence/[a-zA-Z0-9_\\-/]+\\.(json|log|txt|md))$"
            },
            "minItems": 1
          }
        }
      }
    }
  }
}
