{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brainctl.dev/schemas/decision-request.schema.json",
  "title": "DecisionRequest",
  "description": "需要用户参与的技术或产品决策请求",
  "type": "object",
  "required": ["decisionId", "jobId", "taskIds", "type", "question", "options", "blockingScope", "createdAt"],
  "properties": {
    "decisionId": { "type": "string" },
    "jobId": { "type": "string" },
    "taskIds": { "type": "array", "items": { "type": "string" } },
    "type": { "type": "string", "enum": ["product_experience", "high_risk_operation"] },
    "question": { "type": "string" },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "impact"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "impact": { "type": "string" }
        }
      }
    },
    "blockingScope": { "type": "string", "enum": ["affected_tasks_only", "all_tasks"] },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
