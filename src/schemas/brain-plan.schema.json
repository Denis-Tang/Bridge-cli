{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brainctl.dev/schemas/brain-plan.schema.json",
  "title": "BrainPlan",
  "description": "Codex Brain 的施工规划",
  "type": "object",
  "required": ["jobId", "summary", "tasks", "dependencies", "parallelGroups", "decisionRequests", "riskAssessment"],
  "properties": {
    "jobId": { "type": "string" },
    "summary": { "type": "string" },
    "tasks": { "type": "array", "items": { "type": "string" } },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    },
    "parallelGroups": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "string" } }
    },
    "decisionRequests": { "type": "array", "items": { "type": "string" } },
    "riskAssessment": {
      "type": "object",
      "required": ["level", "notes"],
      "properties": {
        "level": { "type": "string", "enum": ["low", "medium", "high"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
